# Copy to .env for local dev:  npm run dev
PORT=3000
BASE_URL=http://localhost:3000          # prod: https://blackswampfablab.com
DATA_DIR=./data                         # prod (Railway volume): /data

ADMIN_PASSWORD=change-me-long-password
SESSION_SECRET=generate-with-openssl-rand-hex-32

STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Printify merch (print on demand) — Printify: profile → Connections → personal access token
PRINTIFY_TOKEN=
PRINTIFY_SHOP_ID=10322062

# Optional — order/quote emails via resend.com (logged to console if unset)
RESEND_API_KEY=
EMAIL_FROM=Black Swamp Fab Lab <orders@blackswampfablab.com>
ADMIN_EMAIL=you@example.com
